FROM maven:3.9.11-eclipse-temurin-17 AS builder
WORKDIR /source
COPY upstream/clastr/backend/ backend/
COPY upstream/clastr/webapp/ webapp/
RUN mvn -B -f backend/pom.xml install && mvn -B -f webapp/pom.xml test org.apache.maven.plugins:maven-war-plugin:3.4.0:war
RUN jlink --add-modules java.se,jdk.unsupported,jdk.crypto.ec --no-header-files --no-man-pages --compress=2 --output /opt/jre
FROM ghcr.io/ninggggy/sgr-webenv-release-runtime:1
ADD https://archive.apache.org/dist/tomcat/tomcat-11/v11.0.11/bin/apache-tomcat-11.0.11.tar.gz /tmp/tomcat.tar.gz
RUN mkdir -p /opt/tomcat && tar -xzf /tmp/tomcat.tar.gz -C /opt/tomcat --strip-components=1 && rm /tmp/tomcat.tar.gz && rm -rf /opt/tomcat/webapps/* && chmod -R a+rX /opt/tomcat
COPY --from=builder /opt/jre /opt/java
COPY --from=builder /source/webapp/target/str-search.war /opt/tomcat/webapps/str-search.war
COPY upstream/clastr/LICENSE /licenses/CLASTR-GPL-3.0.txt
COPY licenses/ /licenses/
COPY docker/start-clastr.sh /start-clastr.sh
ENV JAVA_HOME=/opt/java CATALINA_HOME=/opt/tomcat CATALINA_BASE=/tmp/tomcat
USER 1000:1000
CMD ["sh", "/start-clastr.sh"]
